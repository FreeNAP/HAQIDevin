{
  "expo": {
    "name": "HAQIDevin",
    "slug": "haqidevin",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "devinremote",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#fafaf7",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.haqiai.devin"
    },
    "android": {
      "package": "com.haqiai.devin",
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fafaf7"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "需要相机权限以扫描桌面端配对二维码",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "需要相册权限以选择图片附件发送给 Devin",
          "cameraPermission": "需要相机权限以拍摄照片附件发送给 Devin",
          "microphonePermission": false
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fafaf7"
    }
  }
}